{
  "name": "borshon-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio, CV, project proposal, and website for an artist working in 3D Art and Design.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pdfs": "node --experimental-strip-types scripts/build-pdfs.ts",
    "build:all": "npm run build && npm run pdfs",
    "local": "node --experimental-strip-types scripts/start-local.ts",
    "local:static": "npm run build && node --experimental-strip-types scripts/start-static.ts",
    "verify:pdfs": "node --experimental-strip-types scripts/verify-pdfs.ts"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lenis": "^1.1.20",
    "next": "^15.1.6",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
